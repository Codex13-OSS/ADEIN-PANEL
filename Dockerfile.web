## Node build stage
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

## Production nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

ENV ADEIN_LIA_URL=/lia
EXPOSE 80
HEALTHCHECK --interval=10s CMD curl -s -o /dev/null -w '%{http_code}' http://localhost/api/local/lead-agent/leads | grep -qE '^(200|401)$'
