FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY scripts/ ./scripts/
ENV DEEPSEEK_BASE_URL=https://api.deepseek.com
ENV DEEPSEEK_MODEL=deepseek-chat
ENV LEAD_AGENT_API_TIMEOUT=120000
ENV LEAD_AGENT_LISTEN=0.0.0.0
ENV LEAD_AGENT_PORT=3192
EXPOSE 3192
# node:20-alpine no incluye curl; usar fetch nativo de Node (>=18) para el healthcheck.
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD node -e "fetch('http://127.0.0.1:3192/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "scripts/adein-lead-agent-api-server.mjs"]
